module register_file_tb();

logic clk;
logic i_reg_write;
logic [4:0] i_raddr1;
logic [4:0] i_raddr2;
logic [4:0] i_waddr;
logic [31:0] i_wdata;
logic [31:0] o_rdata1;
logic [31:0] o_rdata2;


register_file u_register_file_1(
.clk (clk),
. i_reg_write(i_reg_write),
.i_raddr1 (i_raddr1),
. i_raddr2(i_raddr2) ,
. i_waddr(i_waddr),
. i_wdata(i_wdata),
.o_rdata1 (o_rdata1),
.o_rdata2 (o_rdata2)
);

always #5 clk = ~clk;

initial begin
clk =0;
i_reg_write =0;
i_raddr1=0;
i_raddr2=0;
i_waddr =0;
i_wdata= 0;

#1

//write test, we will write 25 in register 1
i_wdata =32'd25;
i_waddr = 5'd1;
i_raddr1=5'd1;
i_reg_write = 1;

@(posedge clk);

if(o_rdata1 !== =32'd25)
$error("Error in write");
else
$display ("write works");

//write test, we will write 9 in register 5
#1;

i_wdata =32'd9;
i_waddr = 5'd5;
i_raddr1=5'd1;
i_raddr2=5'd5;
i_reg_write = 1;

@(posedge clk);

if((o_rdata1 !== =32'd25) || (o_rdata2 !== =32'd9))
$error("Error in two port reading");
else
$display ("two port reading works");

//write test, we will write 17 in register 0

#1;

i_wdata =32'd17;
i_waddr = 5'd0;
i_raddr1=5'd0;
i_raddr2=5'd5;
i_reg_write = 1;

@(posedge clk);

if(o_rdata1 !== =32'd0)
$error("Error in R0 protection");
else
$display ("R0 protection works");

//overwrite test, overwrite reg 1 with 30

#1;

i_wdata =32'd30;
i_waddr = 5'd1;
i_raddr1=5'd1;
i_raddr2=5'd5;
i_reg_write = 1;

@(posedge clk);

if(o_rdata1 !== =32'd30)
$error("Error in overwrite");
else
$display ("overwrite works");



$display("pc_reg test complete");
$finish;

end

endmodule








