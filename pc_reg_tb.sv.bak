module pc_reg_tb();
logic clk;
logic rst_n;
logic [31:0] i_next_pc;
logic [31:0] o_pc;


pc_reg u_pc_reg_1(
.clk(clk),
.rst_n(rst_n),
.i_next_pc(i_next_pc),
.o_pc(o_pc);

always #5 clk = ~clk;

clk=0;
rst_n=0;
i_next_pc = 32'h4;
 o_pc=32'h4;
 
 
 //reset test
 

if(  o_pc != 32'd0)
$error("Error is reset");
else
$display ("reset works");

//load test


rst_n=1;
i_next_pc = 32'd50;
o_pc=32'd25;
 
 @(posedge clk);
#1;
if(  o_pc != 32'd25)
$error("Error is load");
else
$display ("load works");

$display("pc_reg test complete");
$finish;

end

endmodule




